# ============================================================
# EKIP — Engineering Knowledge Intelligence Platform
# .env.example
#
# INSTRUCTIONS:
# 1. Copy this file to `.env`  (cp .env.example .env)
# 2. Fill in the values below
# 3. NEVER commit `.env` to git — it's in .gitignore
# ============================================================

# --- Engine & Model Configuration ---
# API key for hosted Gemini models
GEMINI_API_KEY=your_google_api_key_here

# Local endpoint for Ollama or local inference server
OLLAMA_OR_ANY_LOCAL_ENDPOINT=http://localhost:11434

# INFERENCE_ENGINE: HOSTED (online Gemini API) or LOCAL (Ollama endpoint). Defaults to HOSTED
INFERENCE_ENGINE=HOSTED

# EMBEDDING_ENGINE: HOSTED (online Gemini API) or LOCAL (Ollama endpoint). Defaults to HOSTED
EMBEDDING_ENGINE=HOSTED

# Models to use for each task
# Hosted defaults: gemini-3.1-flash-lite, models/gemini-embedding-001
# Local recommendations for 4GB VRAM GPU:
#   Inference: llama3.2:3b, qwen2.5:3b, phi3.5:mini
#   Embedding: nomic-embed-text (~274MB), bge-small-en-v1.5 (~130MB), all-minilm (~120MB)
INFERENCE_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# --- LangSmith (Observability & Evaluation) ---
# Get your key at: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ekip
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- ChromaDB (Local Vector Store) ---
# Where ChromaDB stores its data on disk
CHROMA_PERSIST_DIR=./data/chroma_db

# Name of the ChromaDB collection for indexed documents
CHROMA_COLLECTION_NAME=ekip_docs

# --- Retrieval Settings ---
# How many document chunks to retrieve per query
RETRIEVAL_TOP_K=5

# Minimum similarity score (0.0 to 1.0) for a chunk to be included
RETRIEVAL_MIN_SCORE=0.35

# --- Chunking Settings ---
# Maximum characters per document chunk
CHUNK_SIZE=1000

# How many characters chunks overlap (helps preserve context at boundaries)
CHUNK_OVERLAP=200

# --- API Server ---
# Host and port for the FastAPI server (Phase 4)
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
