# ============================================================
# EKIP — Engineering Knowledge Intelligence Platform
# .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment variables (NEVER commit these) ---
.env
.env.local
.env.*.local

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- ChromaDB local data ---
data/chroma_db/
data/vector_store/

# --- LangSmith / LangChain cache ---
.langchain/
langchain_cache/

# --- Logs ---
logs/
*.log

# --- Jupyter notebooks (keep .ipynb files but not checkpoints) ---
.ipynb_checkpoints/

# --- mypy / type checkers ---
.mypy_cache/
.dmypy.json

# --- uv ---
.uv/
uv.lock

# --- Misc ---
*.bak
*.tmp
Thumbs.db
